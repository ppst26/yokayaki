# =============================================================
# Yokayaki POS — ตัวแปรสภาพแวดล้อม
# คัดลอกเป็น .env.local แล้วใส่ค่าจริง (.env.local ถูก gitignore ไว้แล้ว)
# =============================================================

# --- ฝั่ง client (อยู่ใน JS bundle ที่ทุกคนโหลดได้) -------------
# หลัง migration 20260824 ตัว anon key ไม่มี policy และไม่มี grant เหลืออยู่เลย
# ถือไปก็อ่านหรือเขียนอะไรไม่ได้ — แต่ก็ยังไม่ใช่ความลับอยู่ดี
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_PROMPTPAY_ID=

# --- ฝั่ง server เท่านั้น (ห้ามขึ้นต้นด้วย NEXT_PUBLIC_) ---------
# Dashboard → Settings → API → service_role  ·  bypass RLS ทั้งหมด
SUPABASE_SERVICE_ROLE_KEY=

# Dashboard → Settings → API → JWT Settings → JWT Secret (legacy HS256 — โปรเจกต์ที่ยังไม่ migrate signing keys)
SUPABASE_JWT_SECRET=

# โปรเจกต์ที่ migrate JWT Signing Keys แล้ว (ES256) — รัน `node scripts/gen-jwt-signing-key.mjs`
# import PUBLIC JWK ใน Dashboard → JWT Signing Keys
# วิธี A: บรรทัดเดียว (ห้ามแตกบรรทัด)
# SUPABASE_JWT_SIGNING_JWK={"kty":"EC","kid":"...","d":"...","crv":"P-256","x":"...","y":"..."}
# วิธี B: ไฟล์ (แนะนำ) — gen script จะสร้าง jwt-signing-key.private.json
# SUPABASE_JWT_SIGNING_JWK_FILE=jwt-signing-key.private.json

# Dashboard → Settings → Database → Connection string → Session mode (URI)
# ใช้รัน `node scripts/deploy-m0.mjs` และ `pnpm db:types:local` — ห้าม commit ค่านี้
SUPABASE_DB_URL=

# Dashboard → Project Settings → General → Reference ID (ใช้กับ `pnpm db:types` + Supabase CLI login)
SUPABASE_PROJECT_ID=

# จำนวน proxy ที่เชื่อถือระหว่างผู้ใช้กับ server — ใช้หา IP จริงตอนนับความพยายามล็อกอิน
# Vercel / nginx ชั้นเดียว = 1 (ค่าเริ่มต้น) · ถ้ามี CDN ซ้อน proxy อีกชั้นให้ใส่ 2
TRUSTED_PROXY_HOPS=1

# Dev only — LAN IPs สำหรับทดสอบ QR จากมือถือ (next.config allowedDevOrigins)
# ตัวอย่าง: 192.168.1.100,192.168.1.50
ALLOWED_DEV_ORIGINS=

# --- Cloudflare R2 (อัปโหลดรูปเมนู/โปรโมชั่น) — server-only ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- E2E (Playwright) — ใช้เมื่อรัน pnpm test:e2e:full ---
# E2E_STAFF_PIN=111111
# E2E_TABLE_ID=4
# E2E_MENU_ITEM_NAME=ข้าวสวยญี่ปุ่น
